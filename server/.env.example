# Global Media server configuration
# Copy to .env and adjust. NEVER commit the real .env file.
JWT_SECRET=
PORT=3000
NODE_ENV=development
# Comma-separated allowed CORS origins (browser clients not served by this app).
# Leave empty for same-origin only (recommended for local dev).
CORS_ORIGIN=
JWT_EXPIRES_IN=7d
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=300

# Google "Sign in with Google" (OAuth 2.0). Leave blank to disable.
# Create credentials at https://console.cloud.google.com/apis/credentials
# and register the redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides:
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# APP_BASE_URL=http://localhost:3000
